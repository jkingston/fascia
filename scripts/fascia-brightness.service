[Unit]
Description=Fascia immediate backlight control
After=local-fs.target fascia-device-state.service

[Service]
Type=simple
User=root
Group=fascia
RuntimeDirectory=fascia-device
RuntimeDirectoryMode=0750
ExecStart=/usr/local/libexec/fascia-brightness
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
